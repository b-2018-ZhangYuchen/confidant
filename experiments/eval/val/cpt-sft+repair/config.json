{
  "command": "eval",
  "model": "lab-cache/models/qwen2.5-3b-cpt",
  "adapter": "lab-cache/adapters/cpt-sft",
  "max_tokens": 1024,
  "temperature": 0.0,
  "top_p": 1.0,
  "prompt": "compact",
  "shots": 2,
  "cards": 2,
  "retriever": "bm25max",
  "max_messages": null,
  "split": [
    "val"
  ],
  "gold": false,
  "limit": null,
  "out": "experiments/eval/val/cpt-sft",
  "argv": [
    "rescore",
    "experiments/eval/val/cpt-sft",
    "--repair-quotes",
    "--out",
    "experiments/eval/val/cpt-sft+repair"
  ],
  "rescored_from": "experiments/eval/val/cpt-sft",
  "repair_quotes": true
}
